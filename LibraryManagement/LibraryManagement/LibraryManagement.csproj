<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="Controls\" />
      <Folder Include="Enums\" />
      <Folder Include="Forms\Books\Books\" />
      <Folder Include="Helpers\" />
      <Folder Include="Resources\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Forms\Books\BookCreateForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="UserControl1.cs">
        <SubType>UserControl</SubType>
      </Compile>
      <Compile Update="Forms\LibrarianFormMain\LibrarianMainForm.cs">
        <SubType>Form</SubType>
      </Compile>
      <Compile Update="Forms\Books\BookCopies\BookCopyControl.cs">
        <SubType>UserControl</SubType>
      </Compile>
      <Compile Update="Forms\LoginForm\LoginForm.cs">
        <SubType>Form</SubType>
      </Compile>
    </ItemGroup>

	<ItemGroup>
		<None Update="Data/Migrations/**/*.sql">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    </ItemGroup>

</Project>